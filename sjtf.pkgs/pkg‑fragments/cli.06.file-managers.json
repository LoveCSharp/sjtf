{
  "yazi": {
    "description": "Blazing fast terminal file manager written in Rust",
    "repo": "sxyazi/yazi",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows)(?=.*x86_64)(?=.*msvc).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/yazi",
    "shim": {
      "windows": {
        "symlink": {
          "yazi.exe": "yazi.exe",
          "ya.exe": "ya.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "lf": {
    "description": "Terminal file manager written in Go",
    "repo": "gokcehan/lf",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows)(?=.*amd64).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/lf",
    "shim": {
      "windows": {
        "symlink": {
          "lf.exe": "lf.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
