{
  "fnm": {
    "description": "Fast and simple Node.js version manager",
    "repo": "Schniz/fnm",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "langs/fnm",
    "shim": {
      "windows": {
        "symlink": {
          "fnm.exe": "fnm.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "uv": {
    "description": "Fast Python package installer and resolver written in Rust",
    "repo": "astral-sh/uv",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*x86_64)(?=.*windows)(?=.*msvc).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "langs/uv",
    "shim": {
      "windows": {
        "symlink": {
          "uv.exe": "uv.exe",
          "uvw.exe": "uvw.exe",
          "uvx.exe": "uvx.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "g": {
    "description": "Simple Go version manager for Windows, Linux and macOS",
    "repo": "voidint/g",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows)(?=.*amd64).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "langs/g/bin",
    "shim": {
      "windows": {
        "symlink": {
          "g.exe": "g.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
