{
  "eza": {
    "description": "Modern replacement for ls with colors and Git integration",
    "repo": "eza-community/eza",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*x86_64)(?=.*windows)(?=.*gnu).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/eza",
    "shim": {
      "windows": {
        "symlink": {
          "eza.exe": "eza.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "dust": {
