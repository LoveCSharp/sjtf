            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/duf",
    "shim": {
      "windows": {
        "symlink": {
          "duf.exe": "duf.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
