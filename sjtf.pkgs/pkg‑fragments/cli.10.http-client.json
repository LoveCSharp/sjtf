{
  "xh": {
    "description": "A friendly and fast tool for sending HTTP requests",
    "repo": "ducaale/xh",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows)(?=.*x86_64).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/xh",
    "shim": {
      "windows": {
        "symlink": {
          "xh.exe": "xh.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
