{
  "bottom": {
    "description": "Cross-platform graphical process/system monitor",
    "repo": "ClementTsang/bottom",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*x86_64)(?=.*windows)(?=.*msvc).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/bottom",
    "shim": {
      "windows": {
        "symlink": {
          "btm.exe": "btm.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "procs": {
    "description": "Modern replacement for ps with colorized output",
    "repo": "dalance/procs",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*x86_64)(?=.*windows).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/procs",
    "shim": {
      "windows": {
        "symlink": {
          "procs.exe": "procs.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "witr": {
    "description": "Cross‑platform CLI tool to trace process ancestry and reveal why a process, service or port is running on your system.",
    "repo": "pranshuparmar/witr",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*amd64)(?=.*windows).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/witr",
    "shim": {
      "windows": {
        "symlink": {
          "witr.exe": "witr.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
