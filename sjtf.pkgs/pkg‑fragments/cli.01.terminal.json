{
  "windows-terminal": {
    "description": "Windows Terminal",
    "repo": "microsoft/terminal",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^Microsoft\\.WindowsTerminal_\\d+(\\.\\d+)*_x64\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/windows-terminal",
    "shim": {
      "windows": {
        "desktop_shortcut": {
          "Windows Terminal": {"target": "WindowsTerminal.exe","working_dir":"{PKG_INSTALL_DIR}", "arguments": "", "icon": "WindowsTerminal.exe,0"}
        }
      }
    },
    "fetch_source": "github"
  },
  "zellij": {
    "description": "A terminal workspace with batteries included",
    "repo": "zellij-org/zellij",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*no-web)(?=.*x86_64)(?=.*windows)(?=.*msvc).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/zellij",
    "shim": {
      "windows": {
        "symlink": {
          "zellij.exe": "zellij.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
