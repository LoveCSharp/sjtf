    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows)(?=.*x64).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "ai/pi",
    "shim": {
      "windows": {
        "symlink": {
          "pi.exe": "pi.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "jcode": {
    "description": "The most RAM efficient harness.The most most intelligent harness.",
    "repo": "1jehuang/jcode",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows)(?=.*x86_64).*\\.tar.gz$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "ai/jcode",
    "shim": {
      "windows": {
        "symlink": {
          "jcode.exe": "jcode-windows-x86_64.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
