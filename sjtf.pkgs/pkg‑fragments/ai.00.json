{
  "opencode": {
    "description": "AI-powered coding assistant that runs in your terminal",
    "repo": "anomalyco/opencode",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*windows)(?=.*x64)(?!.*baseline).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "ai/opencode",
    "shim": {
      "windows": {
        "symlink": {
          "opencode.exe": "opencode.exe"
        }
      }
    },
    "fetch_source": "github"
  },
  "pi": {
    "description": "Pi is a minimal agent harness.",
