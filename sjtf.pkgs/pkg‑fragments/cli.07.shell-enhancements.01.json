{
  "zoxide": {
    "description": "Smarter cd command that learns your habits",
    "repo": "ajeetdsouza/zoxide",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*x86_64)(?=.*windows).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/zoxide",
    "shim": {
      "windows": {
        "symlink": {
          "zoxide.exe": "zoxide.exe"
        }
      }
    },
    "fetch_source": "github"
  },
