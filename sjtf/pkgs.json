  "zed": {
    "description": "High-performance multiplayer code editor from the creators of Atom",
    "repo": "zed-industries/zed",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": "(?=.*x86_64).*\\.exe$"
        }
      },
      "type": "installer",
      "install_params": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /TASKS=\"!addtopath\" /DIR=\"{PKG_INSTALL_DIR}\"",
      "uninstall_program": "unins000.exe",
      "uninstall_params": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART"
    },
    "pkg_install_relative_dir": "editor\\zed",
    "shim": {
      "windows": {
        "shell_script": {
          "zed.cmd": "@\"{PKG_INSTALL_DIR}\\bin\\zed.exe\" --user-data-dir \"{PKG_INSTALL_DIR}\\user-data\" %*",
          "zed.ps1": "& \"{PKG_INSTALL_DIR}\\bin\\zed.exe\" --user-data-dir \"{PKG_INSTALL_DIR}\\user-data\" @args"
        }
      }
    },
    "fetch_source": "github"
  },
