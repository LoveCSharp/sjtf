{
  "lolcrab": {
    "description": "make your life more colorful, still boring but more colorful",
    "repo": "mazznoer/lolcrab",
    "fetch_asset": {
      "arch": {
        "windows": {
          "x86_64": {
            "file": "^(?=.*x86_64)(?=.*windows)(?=.*msvc).*\\.zip$",
            "type": "portable-compressed-archive"
          }
        }
      }
    },
    "pkg_install_relative_dir": "cli/lolcrab",
    "shim": {
      "windows": {
        "symlink": {
          "lolcrab.exe": "lolcrab.exe"
        }
      }
    },
    "fetch_source": "github"
  }
}
